// ============================================================================
// 复制为 ios/Configs/Secrets.xcconfig 后填写（该文件已被 .gitignore 忽略，禁止提交）
// 或直接运行：API_BASE_URL="https://..." bash ../scripts/inject-config.sh
// 注意：xcconfig 中 "//" 是注释，URL 写成 https:/$()/host/api
// ============================================================================

API_BASE_URL = https:/$()/your-host.example/api
API_ALLOW_CLEARTEXT = NO
IOS_BUNDLE_ID = com.example.exammobile

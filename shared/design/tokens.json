{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "exam-bank-mobile",
    "version": "1.0.0",
    "note": "三端唯一视觉真源。Android/iOS/Harmony 各自转译为本平台主题，禁止各端私改数值。"
  },
  "color": {
    "primary": "#1F5F99",
    "primaryDark": "#16466F",
    "primaryLight": "#5AA7EA",
    "primarySoft": "#E8F1FA",
    "background": "#F4F6FB",
    "surface": "#FFFFFF",
    "surfaceAlt": "#EEF3F8",
    "textPrimary": "#1F2937",
    "textSecondary": "#8A94A6",
    "textTertiary": "#94A3B8",
    "border": "#E2EAF3",
    "borderStrong": "#CBD5E1",
    "success": "#15803D",
    "successSoft": "#ECFDF5",
    "warning": "#B45309",
    "warningSoft": "#FFFBEB",
    "danger": "#C0392B",
    "dangerSoft": "#FDF2F2",
    "info": "#6D28D9",
    "infoSoft": "#F5F3FF",
    "pink": "#BE185D",
    "pinkSoft": "#FDF2F8",
    "overlay": "#00000066",
    "white": "#FFFFFF"
  },
  "questionTypeColor": {
    "SINGLE": { "text": "#1F5F99", "bg": "#EEF6FF" },
    "MULTIPLE": { "text": "#6D28D9", "bg": "#F5F3FF" },
    "JUDGE": { "text": "#15803D", "bg": "#ECFDF5" },
    "FILL": { "text": "#B45309", "bg": "#FFF7ED" },
    "ESSAY": { "text": "#BE185D", "bg": "#FDF2F8" }

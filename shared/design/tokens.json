  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "fontSize": {
    "caption": 11,
    "small": 13,
    "body": 15,
    "subtitle": 16,
    "title": 17,
    "headline": 20,
    "display": 24
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "layout": {
    "pagePadding": 16,
    "cardPadding": 16,
    "listRowHeight": 56,
    "navBarHeight": 48,
    "tabBarHeight": 56,
    "bottomActionHeight": 64,
    "answerSheetColumns": 5,
    "maxContentWidth": 920
  },
  "tabBar": [
    { "key": "home", "title": "首页", "icon": "home" },
    { "key": "exams", "title": "考试", "icon": "list" },
    { "key": "practice", "title": "练习", "icon": "edit" },
    { "key": "profile", "title": "我的", "icon": "user" }
  ],
  "motion": {
    "fastMs": 150,
    "normalMs": 250,
    "debounceSaveMs": 500,
    "heartbeatMs": 30000,
    "eventThrottleMs": 1000,
    "bannerAutoplayMs": 4000
  }
